# Protección del directorio de controladores
# Denegar acceso directo a archivos PHP
<Files "*.php">
    Order Deny,Allow
    Deny from all
</Files>

# Permitir acceso solo desde el servidor local
<Files "*.php">
    Order Deny,Allow
    Deny from all
    Allow from 127.0.0.1
    Allow from ::1
</Files>
