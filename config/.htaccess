# Protección del directorio de configuración
# Denegar acceso a todos los archivos
<Files "*">
    Order Deny,Allow
    Deny from all
</Files>

# Permitir acceso solo desde localhost (opcional)
# <Files "*">
#     Order Deny,Allow
#     Deny from all
#     Allow from 127.0.0.1
#     Allow from ::1
# </Files>

# Redirigir a página de error personalizada
ErrorDocument 403 /error/403.php
